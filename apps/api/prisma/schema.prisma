generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum KnowledgeStatus {
  CONFIRMED
  ASSUMED
  OPEN
  REJECTED
  NEEDS_REVALIDATION
}

enum QuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
}

enum ReportType {
  UNDERSTANDING
}

enum ReportVersionStatus {
  GENERATING
  FAILED
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  APPROVED_WITH_CONDITIONS
  OUTDATED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  APPROVED_WITH_CONDITIONS
}

enum ConditionStatus {
  OPEN
  MET
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  TOKEN_REUSE_DETECTED
}

enum LlmCallStatus {
  OK
  INVALID_OUTPUT
  REFUSED
  ERROR
}

enum QuestionReason {
  GAP
  AMBIGUITY
  CONFLICT
  MISSING_RULE
}

enum QuestionPriority {
  CRITICAL
  HIGH
  NORMAL
}

enum OrgRole {
  ORG_ADMIN
  MEMBER
}

enum ProjectRole {
  OWNER
  ANALYST
  APPROVER
  VIEWER
}

// ─── Organization ───────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  projects  Project[]
  modules   Module[]
  auditLogs AuditLog[]
  llmUsages LlmUsage[]

  @@map("organizations")
}

// ─── User (soft delete) ─────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  organizationId     String    @db.Uuid
  orgRole            OrgRole   @default(MEMBER)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization            Organization        @relation(fields: [organizationId], references: [id])
  answers                 Answer[]
  reportVersionsCreated   ReportVersion[]     @relation("ReportVersionCreator")
  reportVersionsSubmitted ReportVersion[]     @relation("ReportVersionSubmitter")
  approvalsDecided        Approval[]          @relation("ApprovalDecider")
  conditionsUpdated       ApprovalCondition[] @relation("ConditionUpdater")
  auditLogs               AuditLog[]
  llmUsages               LlmUsage[]
  projectMemberships      ProjectMember[]
  refreshSessions         RefreshSession[]
  createdDocuments        Document[]
  createdVersions         DocumentVersion[]
  createdNotes            ContextNote[]
  createdRequirements     Requirement[]       @relation("RequirementCreator")
  createdBusinessRules    BusinessRule[]      @relation("BusinessRuleCreator")
  createdModules          Module[]            @relation("ModuleCreator")
  createdQuestions        Question[]          @relation("QuestionCreator")
  dismissedQuestions      Question[]          @relation("QuestionDismisser")
  decisionsMade           Decision[]          @relation("DecisionMaker")

  @@index([organizationId])
  @@map("users")
}

// ─── Project ────────────────────────────────────────────────────────────────

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(DRAFT)
  organizationId String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id])
  documents     Document[]
  requirements  Requirement[]
  businessRules BusinessRule[]
  reports       Report[]
  approvals     Approval[]
  llmUsages     LlmUsage[]
  members       ProjectMember[]
  contextNotes  ContextNote[]
  chunks        Chunk[]
  modules       Module[]
  answers       Answer[]
  questions     Question[]
  decisions     Decision[]
  summaries     ProjectSummary[]

  @@index([organizationId])
  @@index([status])
  @@map("projects")
}

// ─── ProjectMember ──────────────────────────────────────────────────────────

model ProjectMember {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  projectId      String      @db.Uuid
  organizationId String      @db.Uuid
  role           ProjectRole
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@map("project_members")
}

// ─── RefreshSession ─────────────────────────────────────────────────────────

model RefreshSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique
  familyId       String    @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  expiresAt      DateTime
  revokedAt      DateTime?
  userAgent      String?
  ip             String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

// ─── Document (soft delete) ─────────────────────────────────────────────────

model Document {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  fileName       String
  mimeType       String?
  status         DocumentStatus @default(UPLOADED)
  errorMessage   String?
  projectId      String         @db.Uuid
  organizationId String         @db.Uuid
  createdById    String         @db.Uuid
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project   Project           @relation(fields: [projectId], references: [id])
  createdBy User              @relation(fields: [createdById], references: [id])
  versions  DocumentVersion[]

  @@index([projectId])
  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@map("documents")
}

// ─── DocumentVersion ────────────────────────────────────────────────────────

model DocumentVersion {
  id             String   @id @default(uuid()) @db.Uuid
  versionNumber  Int
  fileKey        String   @unique
  contentHash    String
  mimeType       String
  sizeBytes      Int
  documentId     String   @db.Uuid
  organizationId String   @db.Uuid
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  document  Document @relation(fields: [documentId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
  chunks    Chunk[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([organizationId])
  @@index([contentHash])
  @@index([createdById])
  @@map("document_versions")
}

// ─── ContextNote ────────────────────────────────────────────────────────────

model ContextNote {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  body           String         @db.Text
  status         DocumentStatus @default(UPLOADED)
  errorMessage   String?
  projectId      String         @db.Uuid
  organizationId String         @db.Uuid
  createdById    String         @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project   Project @relation(fields: [projectId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
  chunks    Chunk[]

  @@index([projectId])
  @@index([organizationId])
  @@index([status])
  @@index([createdById])
  @@map("context_notes")
}

// ─── Chunk ──────────────────────────────────────────────────────────────────

model Chunk {
  id                String    @id @default(uuid()) @db.Uuid
  content           String    @db.Text
  chunkIndex        Int
  tokenCount        Int?
  chunkKey          String    @unique
  contentHash       String
  headingPath       String[]
  needsReview       Boolean   @default(false)
  /// Set when the extraction job has finished with this chunk, successfully or by flagging it for review.
  extractedAt       DateTime?
  documentVersionId String?   @db.Uuid
  contextNoteId     String?   @db.Uuid
  projectId         String    @db.Uuid
  organizationId    String    @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  contextNote     ContextNote?     @relation(fields: [contextNoteId], references: [id], onDelete: Restrict)
  project         Project          @relation(fields: [projectId], references: [id])
  requirements    Requirement[]
  businessRules   BusinessRule[]
  modules         Module[]
  itemSources     ItemSource[]

  @@unique([documentVersionId, chunkIndex])
  @@unique([contextNoteId, chunkIndex])
  @@index([documentVersionId])
  @@index([contextNoteId])
  @@index([projectId])
  @@index([organizationId])
  @@map("chunks")
}

// ─── Requirement (soft delete) ──────────────────────────────────────────────

model Requirement {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  description    String          @db.Text
  status         KnowledgeStatus @default(OPEN)
  priority       Int?
  sourceChunkId  String          @db.Uuid
  moduleId       String?         @db.Uuid
  projectId      String          @db.Uuid
  organizationId String          @db.Uuid
  /// Null when created by the extraction pipeline.
  createdById    String?         @db.Uuid
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  sourceChunk   Chunk          @relation(fields: [sourceChunkId], references: [id])
  module        Module?        @relation(fields: [moduleId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id])
  createdBy     User?          @relation("RequirementCreator", fields: [createdById], references: [id])
  businessRules BusinessRule[]
  questionLinks QuestionLink[]
  extraSources  ItemSource[]

  @@index([projectId])
  @@index([status])
  @@index([sourceChunkId])
  @@index([moduleId])
  @@index([organizationId])
  @@index([createdById])
  @@map("requirements")
}

// ─── BusinessRule ───────────────────────────────────────────────────────────

model BusinessRule {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  description    String          @db.Text
  status         KnowledgeStatus @default(OPEN)
  requirementId  String?         @db.Uuid
  sourceChunkId  String          @db.Uuid
  moduleId       String?         @db.Uuid
  projectId      String          @db.Uuid
  organizationId String          @db.Uuid
  /// Null when created by the extraction pipeline.
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  requirement   Requirement?   @relation(fields: [requirementId], references: [id])
  sourceChunk   Chunk          @relation(fields: [sourceChunkId], references: [id])
  module        Module?        @relation(fields: [moduleId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id])
  createdBy     User?          @relation("BusinessRuleCreator", fields: [createdById], references: [id])
  questionLinks QuestionLink[]
  extraSources  ItemSource[]

  @@index([requirementId])
  @@index([sourceChunkId])
  @@index([moduleId])
  @@index([projectId])
  @@index([status])
  @@index([organizationId])
  @@index([createdById])
  @@map("business_rules")
}

// ─── Module ─────────────────────────────────────────────────────────────────

model Module {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  code           String
  description    String?
  status         KnowledgeStatus @default(OPEN)
  sourceChunkId  String          @db.Uuid
  projectId      String          @db.Uuid
  organizationId String          @db.Uuid
  /// Null when created by the extraction pipeline.
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id])
  sourceChunk   Chunk          @relation(fields: [sourceChunkId], references: [id])
  createdBy     User?          @relation("ModuleCreator", fields: [createdById], references: [id])
  requirements  Requirement[]
  businessRules BusinessRule[]
  questions     Question[]
  questionLinks QuestionLink[]
  extraSources  ItemSource[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([status])
  @@index([sourceChunkId])
  @@index([organizationId])
  @@index([createdById])
  @@map("modules")
}

// ─── Question ───────────────────────────────────────────────────────────────

model Question {
  id               String           @id @default(uuid()) @db.Uuid
  /// The question as the client reads it (exposed as `text`).
  content          String           @db.Text
  status           QuestionStatus   @default(OPEN)
  reason           QuestionReason
  priority         QuestionPriority @default(NORMAL)
  /// Identifies the gap this question is about, so the same gap is never asked twice.
  dedupeKey        String
  /// Optimistic lock: bumped on every answer or dismissal; writers must present the version they read.
  version          Int              @default(1)
  moduleId         String?          @db.Uuid
  /// The question whose answer led to this one (follow-ups and conflicts).
  parentQuestionId String?          @db.Uuid
  /// Null when created by the pipeline.
  createdById      String?          @db.Uuid
  dismissReason    String?          @db.Text
  dismissedById    String?          @db.Uuid
  dismissedAt      DateTime?
  projectId        String           @db.Uuid
  organizationId   String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project     Project        @relation(fields: [projectId], references: [id])
  module      Module?        @relation(fields: [moduleId], references: [id])
  parent      Question?      @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id])
  children    Question[]     @relation("QuestionFollowUps")
  createdBy   User?          @relation("QuestionCreator", fields: [createdById], references: [id])
  dismissedBy User?          @relation("QuestionDismisser", fields: [dismissedById], references: [id])
  answers     Answer[]
  links       QuestionLink[]
  decisions   Decision[]

  @@unique([projectId, dedupeKey])
  @@index([projectId])
  @@index([status])
  @@index([organizationId])
  @@index([moduleId])
  @@index([parentQuestionId])
  @@index([createdById])
  @@index([dismissedById])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@map("questions")
}

// ─── ItemSource ─────────────────────────────────────────────────────────────

/// An extra place an item was found. The item's own `sourceChunkId` is its first source; when a later
/// chunk states the same thing, merging adds a row here instead of a duplicate item.
/// Exactly one of the three item columns is set (CHECK in the migration).
model ItemSource {
  id             String   @id @default(uuid()) @db.Uuid
  chunkId        String   @db.Uuid
  requirementId  String?  @db.Uuid
  ruleId         String?  @db.Uuid
  moduleId       String?  @db.Uuid
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())

  chunk       Chunk         @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  requirement Requirement?  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  rule        BusinessRule? @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  module      Module?       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([chunkId, requirementId])
  @@unique([chunkId, ruleId])
  @@unique([chunkId, moduleId])
  @@index([chunkId])
  @@index([requirementId])
  @@index([ruleId])
  @@index([moduleId])
  @@index([organizationId])
  @@map("item_sources")
}

// ─── QuestionLink (exactly one item per row) ────────────────────────────────

/// The item a question is about. Exactly one of the three item columns is set (CHECK in the migration).
model QuestionLink {
  id             String   @id @default(uuid()) @db.Uuid
  questionId     String   @db.Uuid
  requirementId  String?  @db.Uuid
  ruleId         String?  @db.Uuid
  moduleId       String?  @db.Uuid
  organizationId String   @db.Uuid
  createdAt      DateTime @default(now())

  question    Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  requirement Requirement?  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  rule        BusinessRule? @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  module      Module?       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([questionId, requirementId])
  @@unique([questionId, ruleId])
  @@unique([questionId, moduleId])
  @@index([questionId])
  @@index([requirementId])
  @@index([ruleId])
  @@index([moduleId])
  @@index([organizationId])
  @@map("question_links")
}

// ─── Answer ─────────────────────────────────────────────────────────────────

model Answer {
  id             String    @id @default(uuid()) @db.Uuid
  content        String    @db.Text
  questionId     String    @db.Uuid
  answeredById   String    @db.Uuid
  projectId      String    @db.Uuid
  organizationId String    @db.Uuid
  /// Set once the answer has been applied to the linked items; makes applying idempotent.
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  question   Question  @relation(fields: [questionId], references: [id])
  answeredBy User      @relation(fields: [answeredById], references: [id])
  project    Project   @relation(fields: [projectId], references: [id])
  decision   Decision?

  @@index([questionId])
  @@index([answeredById])
  @@index([projectId])
  @@index([organizationId])
  @@map("answers")
}

// ─── Decision (what an answer changed) ──────────────────────────────────────

model Decision {
  id             String   @id @default(uuid()) @db.Uuid
  answerId       String   @unique @db.Uuid
  questionId     String   @db.Uuid
  decidedById    String   @db.Uuid
  projectId      String   @db.Uuid
  organizationId String   @db.Uuid
  /// One or two sentences on what was decided.
  summary        String   @db.Text
  /// Per affected item: { kind, id, before: { status, title, description }, after: {...}, reason }.
  changes        Json
  /// CONFIRMED items the answer contradicted and that were left untouched: { kind, id, title, explanation }.
  conflicts      Json
  createdAt      DateTime @default(now())

  answer    Answer   @relation(fields: [answerId], references: [id])
  question  Question @relation(fields: [questionId], references: [id])
  decidedBy User     @relation("DecisionMaker", fields: [decidedById], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([questionId])
  @@index([decidedById])
  @@index([projectId, createdAt])
  @@index([organizationId])
  @@map("decisions")
}

// ─── ProjectSummary (versioned project memory) ──────────────────────────────

/// Never edited; a new version is added instead.
model ProjectSummary {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  organizationId String   @db.Uuid
  version        Int
  content        Json
  /// What the summary was built from (item counts), for traceability.
  basedOn        Json
  /// Hash of the inputs; an unchanged fingerprint means there is nothing new to summarise.
  fingerprint    String
  generatedAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, version])
  @@index([projectId])
  @@index([projectId, generatedAt])
  @@index([organizationId])
  @@map("project_summaries")
}

// ─── Report ─────────────────────────────────────────────────────────────────

/// One report per project and type. Its content lives in versions, which are never edited.
model Report {
  id             String     @id @default(uuid()) @db.Uuid
  type           ReportType
  projectId      String     @db.Uuid
  organizationId String     @db.Uuid
  createdAt      DateTime   @default(now())

  project  Project         @relation(fields: [projectId], references: [id])
  versions ReportVersion[]

  @@unique([projectId, type])
  @@index([projectId])
  @@index([organizationId])
  @@map("reports")
}

/// The content is written once, while the version is GENERATING. A trigger in the migration refuses
/// every later change to it, to the version number and to the fingerprint.
model ReportVersion {
  id               String              @id @default(uuid()) @db.Uuid
  reportId         String              @db.Uuid
  version          Int
  status           ReportVersionStatus @default(GENERATING)
  content          Json?
  /// The project summary version the narrative was written from.
  summaryVersion   Int?
  /// Hash of the items the content describes; a different hash later means the project moved on.
  itemsFingerprint String?
  failureReason    String?
  projectId        String              @db.Uuid
  organizationId   String              @db.Uuid
  createdById      String              @db.Uuid
  submittedById    String?             @db.Uuid
  submittedAt      DateTime?
  outdatedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  report      Report    @relation(fields: [reportId], references: [id])
  createdBy   User      @relation("ReportVersionCreator", fields: [createdById], references: [id])
  submittedBy User?     @relation("ReportVersionSubmitter", fields: [submittedById], references: [id])
  approval    Approval?

  @@unique([reportId, version])
  @@index([reportId])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([submittedById])
  @@index([organizationId])
  @@map("report_versions")
}

// ─── Approval ───────────────────────────────────────────────────────────────

/// The decision on one report version, with the baseline it was made against. Written once.
model Approval {
  id                  String           @id @default(uuid()) @db.Uuid
  reportVersionId     String           @unique @db.Uuid
  decision            ApprovalDecision
  /// The reason for a rejection, or the approver's comment.
  comment             String?
  /// Every item with its status and wording, the source versions and the summary version, as they
  /// were when the decision was made.
  baselineSnapshot    Json
  baselineHash        String
  /// Hash of the items alone; when the project's items stop matching it the version is OUTDATED.
  baselineFingerprint String
  projectId           String           @db.Uuid
  organizationId      String           @db.Uuid
  decidedById         String           @db.Uuid
  decidedAt           DateTime         @default(now())

  reportVersion ReportVersion       @relation(fields: [reportVersionId], references: [id])
  decidedBy     User                @relation("ApprovalDecider", fields: [decidedById], references: [id])
  conditions    ApprovalCondition[]
  project       Project             @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([decision])
  @@index([decidedById])
  @@index([organizationId])
  @@map("approvals")
}

model ApprovalCondition {
  id             String          @id @default(uuid()) @db.Uuid
  approvalId     String          @db.Uuid
  text           String
  status         ConditionStatus @default(OPEN)
  organizationId String          @db.Uuid
  updatedById    String?         @db.Uuid
  metAt          DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  approval  Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("ConditionUpdater", fields: [updatedById], references: [id])

  @@index([approvalId])
  @@index([status])
  @@index([updatedById])
  @@index([organizationId])
  @@map("approval_conditions")
}

// ─── AuditLog (immutable) ───────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  action         AuditAction
  entity         String
  entityId       String?     @db.Uuid
  metadata       Json?
  userId         String?     @db.Uuid
  organizationId String?     @db.Uuid
  createdAt      DateTime    @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── LlmUsage (immutable) ───────────────────────────────────────────────────

model LlmUsage {
  id               String        @id @default(uuid()) @db.Uuid
  model            String
  promptName       String?
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  cachedTokens     Int           @default(0)
  latencyMs        Int
  status           LlmCallStatus @default(OK)
  endpoint         String?
  userId           String?       @db.Uuid
  projectId        String?       @db.Uuid
  organizationId   String        @db.Uuid
  createdAt        DateTime      @default(now())

  user         User?        @relation(fields: [userId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([projectId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([projectId, createdAt])
  @@map("llm_usages")
}
