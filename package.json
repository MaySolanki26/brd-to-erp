{
  "name": "brd-platform",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r --filter \"./apps/**\" typecheck",
    "test": "pnpm build:packages && pnpm -r --filter \"./apps/**\" test",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2"
  }
}
